# Copy to .env.local for `vercel dev`, and add the same keys in Vercel > Project > Settings > Environment Variables.
# Never put these in index.html.

# Required. The OpenAI-compatible endpoint and its key.
# OpenRouter (default): https://openrouter.ai/api/v1
# NVIDIA NIM: https://integrate.api.nvidia.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Models to try. On OpenRouter, list several and it falls back to the next if one is busy or down.
# OpenRouter: nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free
# NVIDIA NIM: nvidia/nemotron-3-super-120b-a12b
LLM_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free

# Per model request timeout. Raise it for slow reasoning models / cold starts.
MODEL_TIMEOUT_MS=25000

# NVIDIA NIM: Nemotron reasons before every turn, which roughly doubles latency.
# Off by default; set to "on" to keep the model thinking. Ignored on OpenRouter.
LLM_THINKING=off

# Legacy aliases still accepted: OPENROUTER_API_KEY and OPENROUTER_MODELS.

# Required by the Nominatim usage policy: identify the app and give a contact.
NOMINATIM_USER_AGENT=GeoLLM/0.1 (+https://your-domain; your-contact-email)

# Your public URL (sent to OpenRouter as the referer) and the origins allowed to call /api/chat.
SITE_URL=https://your-domain
ALLOWED_ORIGINS=https://your-domain

# Limits
DAILY_LIMIT_PER_IP=10
DAILY_LIMIT_GLOBAL=500

# Any random string; IPs are hashed with it, never stored raw.
IP_HASH_SALT=change-me

# Optional but recommended: shared rate limit + cache across serverless instances.
# Add "Upstash for Redis" from the Vercel Marketplace; it sets these (or KV_REST_API_URL / KV_REST_API_TOKEN).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: self-hosted or commercial endpoints for production.
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# STAC_URL=https://earth-search.aws.element84.com/v1

# Optional: live ships. Create a free account and key at aisstream.io. Server-side only.
# Without it the ships tool stays off and the page shows "ships next".
AISSTREAM_API_KEY=
# AIS_WAIT_MS=8000

# Optional overrides for shared public servers (use self-hosted or paid ones at scale).
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# ADSB_URL=https://api.adsb.lol
